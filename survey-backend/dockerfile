
# ==========================================
# Stage 1: Build the Spring Boot application
# ==========================================
FROM maven:3.9-eclipse-temurin-21 AS build

WORKDIR /app

# Copy Maven configuration first for dependency caching.
COPY pom.xml .

# Download project dependencies.
RUN mvn -B dependency:go-offline

# Copy application source code.
COPY src ./src

# Package the Spring Boot application.
RUN mvn -B -DskipTests package \
    && JAR_FILE="$(find target -maxdepth 1 -type f -name '*.jar' ! -name '*.jar.original' | head -n 1)" \
    && test -n "$JAR_FILE" \
    && cp "$JAR_FILE" /app/application.jar


# ==========================================
# Stage 2: Run the application
# ==========================================
FROM eclipse-temurin:21-jre AS runtime

WORKDIR /app

# Create a non-root user and persistent database directory.
RUN groupadd --system appgroup \
    && useradd --system --gid appgroup --home-dir /nonexistent --shell /usr/sbin/nologin appuser \
    && mkdir -p /data \
    && chown -R appuser:appgroup /app /data

# Copy only the packaged application from the build stage.
COPY --from=build --chown=appuser:appgroup /app/application.jar ./application.jar

# Application configuration.
ENV SERVER_PORT=5454

# Store SQLite database outside the application directory.
ENV SPRING_DATASOURCE_URL=jdbc:sqlite:/data/mydb.db

# Persistent database location.
VOLUME ["/data"]

# Run the application on port 5454.
EXPOSE 5454

# Run as a non-root user.
USER appuser

# Start Spring Boot.
ENTRYPOINT ["java", "-jar", "application.jar"]
